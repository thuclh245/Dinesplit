<?xml version="1.0" encoding="utf-8"?>
<!--
  DineSplit launcher foreground icon — Fork & Knife crossed
  Designed to match the project logo: white fork and knife on terracotta background.
  Safe zone is 72x72dp centered in 108x108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        FORK (left, rotated ~-30°)
        Fork handle goes from bottom-left to top-right
    -->
    <!-- Fork handle (thick stick) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,76 L40,76 L55,34 L51,34 Z" />

    <!-- Fork tine base (rounded rectangle connecting tines) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49,34 L57,34 L57,38 L49,38 Z" />

    <!-- Fork tine 1 (leftmost) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M49,25 L51,25 L51,38 L49,38 Z" />

    <!-- Fork tine 2 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.5,25 L54.5,25 L54.5,38 L52.5,38 Z" />

    <!-- Fork tine 3 (rightmost) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56,25 L58,25 L58,38 L56,38 Z" />

    <!--
        KNIFE (right, rotated ~+30°)
        Knife goes from bottom-right to top-left
    -->
    <!-- Knife handle (thick stick) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M68,76 L72,76 L57,34 L53,34 Z" />

    <!-- Knife blade (wider at top, tapers down) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53,34 L57,34 L62,25 L57,25 Z" />

    <!-- Knife blade edge detail (sharp side highlight) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,25 L62,25 L60,26.5 Z" />

</vector>
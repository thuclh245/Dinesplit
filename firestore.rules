rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatThreadPath(threadId) {
      return /databases/$(database)/documents/chat_threads/$(threadId);
    }

    function isChatParticipantData(data) {
      return signedIn()
        && (
          (
            data.participantLookup is map
            && data.participantLookup[request.auth.uid] == true
          )
          || (
            data.participants is list
            && request.auth.uid in data.participants
          )
        );
    }

    function isChatParticipantListItem(data) {
      return isChatParticipantData(data);
    }

    function isChatThreadPathForCurrentUser(threadId) {
      return signedIn()
        && (
          threadId.matches(request.auth.uid + '_.*')
          || threadId.matches('.*_' + request.auth.uid)
        );
    }

    function isChatParticipant(threadId) {
      return signedIn()
        && exists(chatThreadPath(threadId))
        && request.auth.uid in get(chatThreadPath(threadId)).data.participants;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'usernameLower',
          'email',
          'avatarUrl',
          'bio',
          'diningStyles',
          'followersCount',
          'followingCount',
          'postsCount',
          'savedPostIds',
          'fcmToken',
          'createdAt',
          'updatedAt',
          'isPublic',
          'followingIds',
          'followerIds'
        ])
        && data.uid is string
        && data.displayName is string
        && data.username is string
        && data.usernameLower is string
        && data.email is string
        && data.avatarUrl is string
        && data.bio is string
        && data.diningStyles is list
        && data.followersCount is int
        && data.followingCount is int
        && data.postsCount is int
        && data.savedPostIds is list
        && data.fcmToken is string
        && (data.createdAt is int || data.createdAt is timestamp)
        && (data.updatedAt is int || data.updatedAt is timestamp)
        && data.isPublic is bool
        && data.followingIds is list
        && data.followerIds is list
        && data.uid == request.auth.uid
        && data.usernameLower == data.username.lower()
        && data.displayName.size() > 0
        && data.username.size() >= 3;
    }

    function validFollowerStatsUpdate(previous, data, uid) {
      return signedIn()
        && uid != request.auth.uid
        && data.diff(previous).affectedKeys().hasOnly(['followerIds', 'followersCount'])
        && previous.followerIds is list
        && data.followerIds is list
        && data.followersCount is int
        && data.followersCount == data.followerIds.size()
        && (
          (
            !(request.auth.uid in previous.followerIds)
            && request.auth.uid in data.followerIds
            && data.followerIds.hasAll(previous.followerIds)
            && data.followerIds.size() == previous.followerIds.size() + 1
          )
          || (
            request.auth.uid in previous.followerIds
            && !(request.auth.uid in data.followerIds)
            && previous.followerIds.hasAll(data.followerIds)
            && data.followerIds.size() == previous.followerIds.size() - 1
          )
        );
    }

    function usernameClaimPath(usernameLower) {
      return /databases/$(database)/documents/usernames/$(usernameLower);
    }

    function validUsernameClaim(data, usernameLower) {
      return data.keys().hasOnly([
          'uid',
          'usernameLower',
          'username',
          'claimedAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.usernameLower is string
        && data.username is string
        && data.claimedAt is int
        && data.updatedAt is int
        && data.uid == request.auth.uid
        && data.usernameLower == usernameLower
        && data.usernameLower == data.username.lower()
        && data.username.size() >= 3;
    }

    function validPersonalTransaction(data, uid, transactionId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'amount',
          'type',
          'categoryId',
          'category',
          'note',
          'date',
          'createdAt',
          'updatedAt',
          'source',
          'sourceGroupId',
          'sourceBillId',
          'recurringRuleId',
          'receiptImageUrl',
          'walletId'
        ])
        && data.id == transactionId
        && data.userId == uid
        && data.amount is number
        && data.amount > 0
        && data.type in ['INCOME', 'EXPENSE']
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.category is string
        && data.category.size() > 0
        && data.note is string
        && data.date is number
        && data.createdAt is number
        && data.updatedAt is number
        && data.source in ['MANUAL', 'SPLIT', 'RECURRING', 'RECEIPT']
        && data.sourceGroupId is string
        && data.sourceBillId is string
        && data.recurringRuleId is string
        && data.receiptImageUrl is string
        && data.walletId is string;
    }

    function validPersonalCategory(data, categoryId) {
      return data.keys().hasOnly([
          'id',
          'name',
          'icon',
          'type',
          'isCustom',
          'description',
          'amountLabel',
          'progress',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && data.id == categoryId
        && data.name is string
        && data.name.size() > 0
        && data.icon is string
        && data.type in ['INCOME', 'EXPENSE']
        && data.isCustom is bool
        && data.description is string
        && data.amountLabel is string
        && data.progress is number
        && data.progress >= 0
        && data.progress <= 1
        && data.isActive is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validPersonalReminder(data, uid, reminderId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'categoryId',
          'categoryName',
          'budgetAmount',
          'currentSpent',
          'threshold',
          'reminderType',
          'isEnabled',
          'lastAlertedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.id == reminderId
        && data.userId == uid
        && data.categoryId is string
        && data.categoryName is string
        && data.categoryName.size() > 0
        && data.budgetAmount is number
        && data.budgetAmount > 0
        && data.currentSpent is number
        && data.currentSpent >= 0
        && data.threshold is number
        && data.threshold > 0
        && data.threshold <= 1
        && data.reminderType in ['DAILY', 'WEEKLY', 'MONTHLY', 'MILESTONE']
        && data.isEnabled is bool
        && data.lastAlertedAt is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validRecurringRule(data, uid, ruleId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'amount',
          'type',
          'categoryId',
          'categoryName',
          'cadence',
          'dayOfMonth',
          'nextRunAt',
          'isEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.id == ruleId
        && data.userId == uid
        && data.name is string
        && data.name.size() > 0
        && data.amount is number
        && data.amount > 0
        && data.type in ['INCOME', 'EXPENSE']
        && data.categoryId is string
        && data.categoryName is string
        && data.cadence in ['WEEKLY', 'MONTHLY']
        && data.dayOfMonth is number
        && data.dayOfMonth >= 1
        && data.dayOfMonth <= 31
        && data.nextRunAt is number
        && data.isEnabled is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validPersonalGoal(data, uid, goalId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'targetAmount',
          'currentAmount',
          'categoryId',
          'deadlineAt',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.id == goalId
        && data.userId == uid
        && data.title is string
        && data.title.size() > 0
        && data.targetAmount is number
        && data.targetAmount > 0
        && data.currentAmount is number
        && data.currentAmount >= 0
        && data.categoryId is string
        && data.deadlineAt is number
        && data.status in ['ACTIVE', 'COMPLETED', 'PAUSED']
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validPersonalWallet(data, uid, walletId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'name',
          'walletType',
          'balance',
          'color',
          'isArchived',
          'createdAt',
          'updatedAt'
        ])
        && data.id == walletId
        && data.userId == uid
        && data.name is string
        && data.name.size() > 0
        && data.walletType in ['CASH', 'BANK', 'EWALLET', 'CREDIT']
        && data.balance is number
        && data.color is string
        && data.isArchived is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validNotification(data, uid, notificationId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'subtitle',
          'type',
          'relatedId',
          'isRead',
          'createdAt',
          'updatedAt',
          'deepLinkDestination',
          'deepLinkTargetId',
          'senderId',
          'groupId'
        ])
        && data.id == notificationId
        && data.userId == uid
        && data.title is string
        && data.title.size() > 0
        && data.subtitle is string
        && data.type in [
          'PAYMENT_COMPLETED',
          'PAYMENT_PENDING',
          'BILL_CREATED',
          'SPLIT_COMPLETED',
          'TRANSACTION_ALERT',
          'ACTIVITY_UPDATE',
          'OTHER'
        ]
        && data.relatedId is string
        && data.isRead is bool
        && data.createdAt is number
        && data.updatedAt is number
        && data.deepLinkDestination is string
        && data.deepLinkTargetId is string
        && (!data.keys().hasAny(['senderId']) || data.senderId is string)
        && (!data.keys().hasAny(['groupId']) || data.groupId is string);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in groupData(groupId).memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && groupData(groupId).ownerId == request.auth.uid;
    }

    function validCrossUserSplitNotification(data, uid) {
      return signedIn()
        && data.type in ['BILL_CREATED', 'PAYMENT_PENDING', 'PAYMENT_COMPLETED', 'SPLIT_COMPLETED']
        && data.senderId == request.auth.uid
        && data.groupId is string
        && request.auth.uid in groupData(data.groupId).memberIds
        && uid in groupData(data.groupId).memberIds
        && exists(/databases/$(database)/documents/groups/$(data.groupId)/bills/$(data.relatedId));
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function storyPath(storyId) {
      return /databases/$(database)/documents/stories/$(storyId);
    }

    function validCrossUserActivityNotification(data, uid) {
      return signedIn()
        && data.type == 'ACTIVITY_UPDATE'
        && data.senderId == request.auth.uid
        && data.userId == uid
        && uid != request.auth.uid
        && data.deepLinkDestination in ['PROFILE', 'ACTIVITY_DETAIL', 'POST_DETAIL']
        && data.relatedId is string
        && data.deepLinkTargetId is string
        && (
          (
            data.deepLinkDestination in ['ACTIVITY_DETAIL', 'POST_DETAIL']
            && data.deepLinkTargetId == data.relatedId
            && exists(postPath(data.relatedId))
            && get(postPath(data.relatedId)).data.authorUid == uid
          )
          || (
            data.deepLinkDestination == 'PROFILE'
            && data.deepLinkTargetId == request.auth.uid
            && data.relatedId == request.auth.uid
          )
          || (
            data.deepLinkDestination == 'PROFILE'
            && data.deepLinkTargetId == request.auth.uid
            && exists(storyPath(data.relatedId))
            && getAfter(storyPath(data.relatedId)).data.authorUid == uid
            && request.auth.uid in getAfter(storyPath(data.relatedId)).data.likedBy
          )
        );
    }

    function validStoryLikeUpdate(previous, data) {
      return signedIn()
        && previous.authorUid != request.auth.uid
        && data.diff(previous).affectedKeys().hasOnly(['likedBy', 'likesCount'])
        && data.likedBy is list
        && data.likesCount is int
        && data.likesCount == data.likedBy.size()
        && (
          (
            !previous.keys().hasAny(['likedBy'])
            && request.auth.uid in data.likedBy
            && data.likedBy.size() == 1
          )
          || (
            previous.likedBy is list
            && !(request.auth.uid in previous.likedBy)
            && request.auth.uid in data.likedBy
            && data.likedBy.hasAll(previous.likedBy)
            && data.likedBy.size() == previous.likedBy.size() + 1
          )
          || (
            previous.likedBy is list
            && request.auth.uid in previous.likedBy
            && !(request.auth.uid in data.likedBy)
            && previous.likedBy.hasAll(data.likedBy)
            && data.likedBy.size() == previous.likedBy.size() - 1
          )
        );
    }

    function validQrPayment(data, paymentId) {
      return data.keys().hasOnly([
          'id',
          'groupId',
          'billId',
          'payerUid',
          'receiverUid',
          'amount',
          'bankTransactionRef',
          'qrContent',
          'status',
          'description',
          'paymentGateway',
          'verifiedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.id == paymentId
        && data.groupId is string
        && data.billId is string
        && data.payerUid is string
        && data.receiverUid is string
        && data.amount is number
        && data.amount > 0
        && data.bankTransactionRef is string
        && data.qrContent is string
        && data.status in ['PENDING', 'MARKED_PAID', 'CONFIRMED', 'REJECTED']
        && data.description is string
        && data.paymentGateway is string
        && data.verifiedAt is number
        && data.createdAt is number
        && data.updatedAt is number
        && exists(/databases/$(database)/documents/groups/$(data.groupId)/bills/$(data.billId))
        && data.payerUid in groupData(data.groupId).memberIds
        && data.receiverUid in groupData(data.groupId).memberIds
        && data.payerUid != data.receiverUid;
    }

    function canReadQrPayment(data) {
      return signedIn()
        && request.auth.uid in groupData(data.groupId).memberIds;
    }

    function canCreateQrPayment(data, paymentId) {
      return validQrPayment(data, paymentId)
        && data.payerUid == request.auth.uid
        && data.status == 'PENDING';
    }

    function canUpdateQrPayment(previous, data, paymentId) {
      return validQrPayment(data, paymentId)
        && data.groupId == previous.groupId
        && data.billId == previous.billId
        && data.payerUid == previous.payerUid
        && data.receiverUid == previous.receiverUid
        && data.amount == previous.amount
        && (
          (
            previous.status in ['PENDING', 'REJECTED']
            && data.status == 'MARKED_PAID'
            && request.auth.uid == previous.payerUid
          )
          || (
            previous.status == 'REJECTED'
            && data.status == 'PENDING'
            && request.auth.uid == previous.payerUid
          )
          || (
            previous.status == 'MARKED_PAID'
            && data.status in ['CONFIRMED', 'REJECTED']
            && request.auth.uid == previous.receiverUid
          )
        );
    }

    function validNewGroup(data, groupId) {
      return signedIn()
        && data.keys().hasOnly([
          'id',
          'name',
          'imageUrl',
          'memberCount',
          'memberIds',
          'leftMemberIds',
          'ownerId',
          'totalExpense',
          'yourBalance',
          'createdAt',
          'updatedAt'
        ])
        && data.id == groupId
        && data.name is string
        && data.name.size() > 0
        && data.memberIds is list
        && data.leftMemberIds is list
        && data.ownerId == request.auth.uid
        && request.auth.uid in data.memberIds
        && data.memberCount == data.memberIds.size()
        && data.leftMemberIds.size() == 0
        && data.totalExpense == 0
        && data.yourBalance == 0
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function validNewMember(data, groupId, memberId) {
      return data.keys().hasOnly(['id', 'name', 'initial', 'avatarUrl', 'isMe'])
        && data.id == memberId
        && data.name is string
        && data.name.size() > 0
        && data.initial is string
        && (!data.keys().hasAny(['avatarUrl']) || data.avatarUrl is string)
        && data.isMe is bool
        && data.isMe == (memberId == request.auth.uid)
        && memberId in getAfter(groupPath(groupId)).data.memberIds;
    }

    function validNewBill(data, groupId, billId) {
      return data.keys().hasOnly([
          'id',
          'groupId',
          'name',
          'totalAmount',
          'payerId',
          'method',
          'items',
          'shares',
          'paidMemberIds',
          'createdBy',
          'paymentQrBankCode',
          'paymentQrAccountNumber',
          'paymentQrAccountName',
          'date',
          'updatedAt'
        ])
        && data.id == billId
        && data.groupId == groupId
        && data.name is string
        && data.name.size() > 0
        && (data.totalAmount is int || data.totalAmount is float)
        && data.totalAmount > 0
        && data.payerId in groupData(groupId).memberIds
        && data.method in ['EQUAL', 'CUSTOM', 'ITEMIZED']
        && data.items is list
        && data.shares is map
        && data.shares.keys().hasOnly(groupData(groupId).memberIds)
        && data.paidMemberIds is list
        && data.paidMemberIds.hasOnly([data.payerId])
        && data.paidMemberIds.hasAll([data.payerId])
        && data.createdBy == request.auth.uid
        && data.paymentQrBankCode is string
        && data.paymentQrAccountNumber is string
        && data.paymentQrAccountName is string
        && data.date is int
        && data.updatedAt is int;
    }

    function validEditedBill(data, previous, groupId, billId) {
      return data.keys().hasOnly([
          'id',
          'groupId',
          'name',
          'totalAmount',
          'payerId',
          'method',
          'items',
          'shares',
          'paidMemberIds',
          'createdBy',
          'paymentQrBankCode',
          'paymentQrAccountNumber',
          'paymentQrAccountName',
          'date',
          'updatedAt'
        ])
        && data.id == billId
        && data.groupId == groupId
        && data.name is string
        && data.name.size() > 0
        && (data.totalAmount is int || data.totalAmount is float)
        && data.totalAmount > 0
        && data.payerId in groupData(groupId).memberIds
        && data.method in ['EQUAL', 'CUSTOM', 'ITEMIZED']
        && data.items is list
        && data.shares is map
        && data.shares.keys().hasOnly(groupData(groupId).memberIds)
        && data.paidMemberIds is list
        && data.paidMemberIds.hasOnly(groupData(groupId).memberIds)
        && data.paidMemberIds.hasAll([data.payerId])
        && previous.createdBy == request.auth.uid
        && data.createdBy == previous.createdBy
        && data.paymentQrBankCode is string
        && data.paymentQrAccountNumber is string
        && data.paymentQrAccountName is string
        && data.date is int
        && data.updatedAt is int;
    }

    match /users/{uid} {
      allow get, list: if signedIn();
      allow create: if isOwner(uid) && validUserProfile(request.resource.data);
      allow update: if isOwner(uid) && validUserProfile(request.resource.data);
      allow update: if validFollowerStatsUpdate(resource.data, request.resource.data, uid);
      allow delete: if isOwner(uid);

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn()
          && request.auth.uid == followerUid;
      }

      match /fcmTokens/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validUsernameClaim(request.resource.data, usernameLower);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validUsernameClaim(request.resource.data, usernameLower);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /user_personal/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalTransaction(request.resource.data, uid, transactionId);
        allow delete: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalCategory(request.resource.data, categoryId);
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalReminder(request.resource.data, uid, reminderId);
        allow delete: if isOwner(uid);
      }

      match /recurring_rules/{ruleId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validRecurringRule(request.resource.data, uid, ruleId);
        allow delete: if isOwner(uid);
      }

      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalGoal(request.resource.data, uid, goalId);
        allow delete: if isOwner(uid);
      }

      match /wallets/{walletId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalWallet(request.resource.data, uid, walletId);
        allow delete: if isOwner(uid);
      }
    }

    match /user_notifications/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if validNotification(request.resource.data, uid, notificationId)
          && (
            isOwner(uid)
            || validCrossUserSplitNotification(request.resource.data, uid)
            || validCrossUserActivityNotification(request.resource.data, uid)
          );
        allow update: if isOwner(uid)
          && validNotification(request.resource.data, uid, notificationId);
        allow delete: if isOwner(uid);
      }
    }

    match /qr_payments/{paymentId} {
      allow read: if canReadQrPayment(resource.data);
      allow create: if signedIn()
        && canCreateQrPayment(request.resource.data, paymentId);
      allow update: if signedIn()
        && canUpdateQrPayment(resource.data, request.resource.data, paymentId);
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read, write: if signedIn();

      match /comments/{commentId} {
        allow read, write: if signedIn();
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == storyId
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid;
      allow update: if validStoryLikeUpdate(resource.data, request.resource.data);
      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    match /chat_threads/{threadId} {
      allow get: if isChatParticipantData(resource.data)
        || isChatThreadPathForCurrentUser(threadId);
      allow list: if isChatParticipantListItem(resource.data);
      allow create: if isChatParticipantData(request.resource.data)
        && request.resource.data.participants.size() == 2;
      allow update: if isChatParticipantData(resource.data);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(threadId);
        allow create: if isChatParticipant(threadId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isChatParticipant(threadId);
        allow delete: if false;
      }

      match /calls/{callId} {
        allow read: if isChatParticipant(threadId);
        allow create: if isChatParticipant(threadId)
          && request.resource.data.callerId == request.auth.uid;
        allow update: if isChatParticipant(threadId);
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow create: if validNewGroup(request.resource.data, groupId);

      allow get, list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      // The current client denormalizes bill totals onto the group document.
      allow update: if isGroupMember(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalExpense', 'updatedAt'])
        && (request.resource.data.totalExpense is int || request.resource.data.totalExpense is float)
        && request.resource.data.totalExpense >= 0
        && request.resource.data.updatedAt is int;

      allow update: if isGroupMember(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'leftMemberIds', 'memberCount', 'ownerId', 'updatedAt'])
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && request.auth.uid in request.resource.data.leftMemberIds
        && request.resource.data.memberCount == request.resource.data.memberIds.size()
        && (
          (
            resource.data.ownerId != request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          )
          || (
            resource.data.ownerId == request.auth.uid
            && (
              (
                request.resource.data.memberIds.size() > 0
                && request.resource.data.ownerId in request.resource.data.memberIds
              )
              || (
                request.resource.data.memberIds.size() == 0
                && request.resource.data.ownerId == ''
              )
            )
          )
        );

      allow delete: if isGroupOwner(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);

        allow create: if signedIn()
          && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid
          && validNewMember(request.resource.data, groupId, memberId);

        allow delete: if isGroupOwner(groupId)
          || (isGroupMember(groupId) && request.auth.uid == memberId);
      }

      match /bills/{billId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && validNewBill(request.resource.data, groupId, billId);

        allow update: if isGroupMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paidMemberIds', 'updatedAt'])
          && request.resource.data.paidMemberIds is list
          && request.resource.data.paidMemberIds.hasAll(resource.data.paidMemberIds)
          && request.resource.data.paidMemberIds.hasOnly(groupData(groupId).memberIds)
          && request.resource.data.paidMemberIds.size()
            <= resource.data.paidMemberIds.size() + 1
          && (
            isGroupOwner(groupId)
            || (
              request.auth.uid in request.resource.data.paidMemberIds
              && !(request.auth.uid in resource.data.paidMemberIds)
            )
          );

        allow update: if isGroupMember(groupId)
          && validEditedBill(request.resource.data, resource.data, groupId, billId);

        allow delete: if isGroupMember(groupId)
          && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'usernameLower',
          'email',
          'avatarUrl',
          'bio',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.displayName is string
        && data.username is string
        && data.usernameLower is string
        && data.email is string
        && data.avatarUrl is string
        && data.bio is string
        && data.createdAt is int
        && data.updatedAt is int
        && data.uid == request.auth.uid
        && data.usernameLower == lower(data.username)
        && data.displayName.size() > 0
        && data.username.size() >= 3;
    }

    function usernameClaimPath(usernameLower) {
      return /databases/$(database)/documents/username_claims/$(usernameLower);
    }

    function claimMatchesProfileAfterWrite(data) {
      return existsAfter(usernameClaimPath(data.usernameLower))
        && getAfter(usernameClaimPath(data.usernameLower)).data.uid == request.auth.uid
        && getAfter(usernameClaimPath(data.usernameLower)).data.usernameLower == data.usernameLower
        && getAfter(usernameClaimPath(data.usernameLower)).data.username == data.username;
    }

    function validUsernameClaim(data, usernameLower) {
      return data.keys().hasOnly(['uid', 'usernameLower', 'username'])
        && data.uid is string
        && data.usernameLower is string
        && data.username is string
        && data.uid == request.auth.uid
        && data.usernameLower == usernameLower
        && data.usernameLower == lower(data.username)
        && data.username.size() >= 3;
    }

    function validPersonalTransaction(data, uid, transactionId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'amount',
          'type',
          'categoryId',
          'category',
          'note',
          'date',
          'createdAt',
          'updatedAt'
        ])
        && data.id == transactionId
        && data.userId == uid
        && data.amount is number
        && data.amount > 0
        && data.type in ['INCOME', 'EXPENSE']
        && data.categoryId is string
        && data.categoryId.size() > 0
        && data.category is string
        && data.category.size() > 0
        && data.note is string
        && data.date is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validPersonalCategory(data, categoryId) {
      return data.keys().hasOnly([
          'id',
          'name',
          'icon',
          'type',
          'isCustom',
          'description',
          'amountLabel',
          'progress',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && data.id == categoryId
        && data.name is string
        && data.name.size() > 0
        && data.icon is string
        && data.type in ['INCOME', 'EXPENSE']
        && data.isCustom is bool
        && data.description is string
        && data.amountLabel is string
        && data.progress is number
        && data.progress >= 0
        && data.progress <= 1
        && data.isActive is bool
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validPersonalReminder(data, uid, reminderId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'categoryId',
          'categoryName',
          'budgetAmount',
          'currentSpent',
          'threshold',
          'reminderType',
          'isEnabled',
          'lastAlertedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.id == reminderId
        && data.userId == uid
        && data.categoryId is string
        && data.categoryName is string
        && data.categoryName.size() > 0
        && data.budgetAmount is number
        && data.budgetAmount > 0
        && data.currentSpent is number
        && data.currentSpent >= 0
        && data.threshold is number
        && data.threshold > 0
        && data.threshold <= 1
        && data.reminderType in ['DAILY', 'WEEKLY', 'MONTHLY', 'MILESTONE']
        && data.isEnabled is bool
        && data.lastAlertedAt is number
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validNotification(data, uid, notificationId) {
      return data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'subtitle',
          'type',
          'relatedId',
          'isRead',
          'createdAt',
          'updatedAt',
          'deepLinkDestination',
          'deepLinkTargetId'
        ])
        && data.id == notificationId
        && data.userId == uid
        && data.title is string
        && data.title.size() > 0
        && data.subtitle is string
        && data.type in [
          'PAYMENT_COMPLETED',
          'PAYMENT_PENDING',
          'BILL_CREATED',
          'SPLIT_COMPLETED',
          'TRANSACTION_ALERT',
          'ACTIVITY_UPDATE',
          'OTHER'
        ]
        && data.relatedId is string
        && data.isRead is bool
        && data.createdAt is number
        && data.updatedAt is number
        && data.deepLinkDestination is string
        && data.deepLinkTargetId is string;
    }

    match /user_profiles/{uid} {
      allow get, list: if signedIn();
      allow create: if isOwner(uid) && validUserProfile(request.resource.data) && claimMatchesProfileAfterWrite(request.resource.data);
      allow update: if isOwner(uid) && validUserProfile(request.resource.data) && claimMatchesProfileAfterWrite(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /username_claims/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validUsernameClaim(request.resource.data, usernameLower);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validUsernameClaim(request.resource.data, usernameLower);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /user_personal/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalTransaction(request.resource.data, uid, transactionId);
        allow delete: if isOwner(uid);
      }

      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalCategory(request.resource.data, categoryId);
        allow delete: if isOwner(uid);
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPersonalReminder(request.resource.data, uid, reminderId);
        allow delete: if isOwner(uid);
      }
    }

    match /user_notifications/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validNotification(request.resource.data, uid, notificationId);
        allow delete: if isOwner(uid);
      }
    }
  }
}

